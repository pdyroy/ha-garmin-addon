#!/command/with-contenv bashio
# shellcheck shell=bash
# SPDX-License-Identifier: MIT
# ==============================================================================
# Pacer — s6-overlay run script
# ==============================================================================

declare -r DATA_DIR="/data"
declare -r LOG_DIR="/app/logs"
declare -r SHARE_BACKUP="/share/pacer"

mkdir -p "${LOG_DIR}" "${DATA_DIR}" "${SHARE_BACKUP}"

# ─── Restore database from /share/ (survives uninstall) ─────────────────────
# NOTE: Garmin tokens are deliberately NOT kept in /share/ — it is readable by
# other add-ons, so credential material stays in /data only.
restore_database() {
    if [ -f "${SHARE_BACKUP}/pacer.sql.gz" ] && [ -n "$1" ]; then
        # Only restore if the database is empty (fresh install)
        local row_count
        row_count=$(psql -h 127.0.0.1 -U postgres -d pacer -tAc \
            "SELECT COUNT(*) FROM daily_metric;" 2>/dev/null || echo "0")
        if [ "${row_count}" = "0" ] || [ "${row_count}" = "" ]; then
            bashio::log.info "Restoring database from /share/ backup..."
            gunzip -c "${SHARE_BACKUP}/pacer.sql.gz" | \
                psql -h 127.0.0.1 -U postgres -d pacer -q 2>/dev/null || \
                bashio::log.warning "Database restore had warnings (may be OK)"
            # Clean stale computed VO2max — will be re-synced from Garmin API
            psql -h 127.0.0.1 -U postgres -d pacer -qc \
                "DELETE FROM vo2max_estimate WHERE source IN ('running_pace_hr', 'uth_method');" 2>/dev/null || true
            bashio::log.info "Database restore complete (stale VO2max cleared)"
        fi
    fi
}

backup_to_share() {
    bashio::log.info "Backing up database to /share/..."
    # NOTE: tokens are deliberately NOT backed up — /share/ is readable by
    # other add-ons, so credential material stays in /data only.
    # Backup database (compressed)
    if pg_isready -h 127.0.0.1 -p 5432 -U postgres -q 2>/dev/null; then
        pg_dump -h 127.0.0.1 -U postgres pacer 2>/dev/null | \
            gzip > "${SHARE_BACKUP}/pacer.sql.gz.tmp" && \
            mv "${SHARE_BACKUP}/pacer.sql.gz.tmp" "${SHARE_BACKUP}/pacer.sql.gz"
    fi
    bashio::log.info "Backup complete → /share/pacer/"
}

# ─── PID tracking & cleanup ──────────────────────────────────────────────────
SYNC_PID=""
STRAVA_SYNC_PID=""
COMPUTE_PID=""
NOTIFY_PID=""
MEMORY_PID=""
RESCORE_PID=""
NEXTJS_PID=""
INGRESS_PID=""
SHUTTING_DOWN=false

# Every supervised child must be listed here. A worker that is started but
# never killed still holds the bare `wait` below, so the service never exits
# and the Supervisor SIGKILLs the whole container after its stop timeout —
# taking PostgreSQL down mid-write.
all_worker_pids() {
    echo "${SYNC_PID} ${STRAVA_SYNC_PID} ${COMPUTE_PID} ${NOTIFY_PID}" \
         "${MEMORY_PID} ${RESCORE_PID} ${NEXTJS_PID} ${INGRESS_PID}"
}

cleanup() {
    # The trap fires for EXIT as well as INT/TERM, so without this guard a
    # normal stop ran the whole body twice — two full pg_dump | gzip passes,
    # doubling the shutdown window that causes the timeout in the first place.
    if [ "${SHUTTING_DOWN}" = "true" ]; then
        return 0
    fi
    SHUTTING_DOWN=true

    bashio::log.info "Shutting down Pacer services..."
    # Backup before shutdown
    backup_to_share

    local pid
    for pid in $(all_worker_pids); do
        [ -n "${pid}" ] && kill "${pid}" 2>/dev/null
    done

    # Wait briefly for a clean exit, then insist. Unbounded `wait` here is what
    # let a single unresponsive child hang the stop indefinitely.
    local waited=0
    while [ "${waited}" -lt 15 ]; do
        local alive=false
        for pid in $(all_worker_pids); do
            [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null && alive=true
        done
        [ "${alive}" = "false" ] && break
        sleep 1
        waited=$((waited + 1))
    done
    for pid in $(all_worker_pids); do
        [ -n "${pid}" ] && kill -9 "${pid}" 2>/dev/null
    done
    wait 2>/dev/null || true

    bashio::log.info "All services stopped."
}
trap cleanup EXIT INT TERM

# ─── Read addon configuration ─────────────────────────────────────────────────
GARMIN_EMAIL=$(bashio::config 'garmin_email')
GARMIN_PASSWORD=$(bashio::config 'garmin_password')
STRAVA_CLIENT_ID=$(bashio::config 'strava_client_id' || echo "")
STRAVA_CLIENT_SECRET=$(bashio::config 'strava_client_secret' || echo "")
STRAVA_REFRESH_TOKEN=$(bashio::config 'strava_refresh_token' || echo "")
AI_BACKEND=$(bashio::config 'ai_backend' || echo "none")
OPENROUTER_API_KEY=$(bashio::config 'openrouter_api_key' || echo "")
OPENROUTER_MODEL=$(bashio::config 'openrouter_model' || echo "google/gemini-2.5-flash-lite")
OPENROUTER_PROVIDERS=$(bashio::config 'openrouter_providers' || echo "")
OPENROUTER_REASONING=$(bashio::config 'openrouter_reasoning' || echo "off")
OLLAMA_URL=$(bashio::config 'ollama_url' || echo "")
OLLAMA_EMBED_MODEL=$(bashio::config 'ollama_embed_model' || echo "nomic-embed-text")
SYNC_INTERVAL=$(bashio::config 'sync_interval_minutes' || echo "60")
USER_TIMEZONE=$(bashio::config 'user_timezone' || echo "UTC")

export GARMIN_EMAIL GARMIN_PASSWORD
export STRAVA_CLIENT_ID STRAVA_CLIENT_SECRET STRAVA_REFRESH_TOKEN
export AI_BACKEND
export OPENROUTER_API_KEY
export OPENROUTER_PROVIDERS
export OPENROUTER_REASONING
export OPENROUTER_MODEL="${OPENROUTER_MODEL:-google/gemini-2.5-flash-lite}"
export OLLAMA_URL
export OLLAMA_MODEL="${OLLAMA_MODEL:-gpt-oss:20b}"
export OLLAMA_EMBED_MODEL="${OLLAMA_EMBED_MODEL:-nomic-embed-text}"
export USER_TIMEZONE
export DATABASE_URL="postgresql://postgres@127.0.0.1:5432/pacer"
export POSTGRES_URL="postgresql://postgres@127.0.0.1:5432/pacer"
# Single-user auth passthrough: HA ingress is the authentication layer, so
# the bundled app runs with its own auth bypassed (documented single-user
# model — see app repo #278). The variable name is historical; a rename to
# INGRESS_AUTH_PASSTHROUGH is pending in the app repo.
export DEV_BYPASS_AUTH="true"
export NODE_ENV="production"
export AUTH_SECRET="ha-addon-local-secret-$(cat /proc/sys/kernel/random/boot_id)"
export AUTH_DISCORD_ID="unused"
export AUTH_DISCORD_SECRET="unused"

# Shared secret for the internal task endpoints (e.g. memory rebuild). Generated
# once per boot and exported to Next.js, then sent as x-internal-token on the
# loopback cron POSTs below so the endpoint stays authenticated (fail-closed).
export INTERNAL_TASK_TOKEN="${INTERNAL_TASK_TOKEN:-$(cat /proc/sys/kernel/random/uuid)}"

# HA Supervisor API token (auto-injected by Supervisor for addons with homeassistant_api: true)
export SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}"
export HA_BASE_URL="http://supervisor/core"

# ─── Wait for PostgreSQL and initialize database ─────────────────────────────
bashio::log.info "Waiting for PostgreSQL..."
for i in $(seq 1 60); do
    if pg_isready -h 127.0.0.1 -p 5432 -U postgres -q; then
        break
    fi
    sleep 1
done
# Everything after this point tolerates failure (|| true, 2>/dev/null,
# || log.warning), so without this check a slow first initdb produced a boot
# that created no database, pushed no schema, and still logged
# "All services started".
if ! pg_isready -h 127.0.0.1 -p 5432 -U postgres -q; then
    bashio::log.fatal "PostgreSQL did not become ready in 60s — aborting start."
    bashio::exit.nok
fi

# Ensure token directory exists (needed for migration marker)
mkdir -p /data/garmin-tokens

# Create database if it doesn't exist
if ! psql -h 127.0.0.1 -U postgres -lqt 2>/dev/null | cut -d \| -f 1 | grep -qw pacer; then
    bashio::log.info "Creating pacer database..."
    createdb -h 127.0.0.1 -U postgres pacer 2>/dev/null || true
fi

# Push schema to database (creates tables if missing).
#
# Deliberately NOT --force: that flag accepts every destructive statement the
# diff produces, so any column present in the database but absent from
# schema.ts was silently dropped on every boot. A failing push must stop the
# boot rather than continue against a half-migrated database — running on a
# schema the app does not expect corrupts data instead of merely erroring.
bashio::log.info "Pushing database schema..."
if ! (cd /app/packages/db && POSTGRES_URL="${POSTGRES_URL}" npx drizzle-kit push 2>&1); then
    bashio::log.fatal "Database schema push failed — refusing to start with a mismatched schema."
    bashio::exit.nok
fi

# Restore database from /share/ backup if this is a fresh install
restore_database "check"

# Create/refresh materialized view after schema push + restore + migrations
# Add data_quality column if missing (addon-managed, not in Drizzle schema)
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS data_quality INTEGER DEFAULT 0;" 2>/dev/null

# Add garmin_training_load column if missing
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_training_load DOUBLE PRECISION;" 2>/dev/null

# Add Garmin Training Readiness columns
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_training_readiness INTEGER;" 2>/dev/null
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_training_readiness_level TEXT;" 2>/dev/null
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_readiness_factors JSONB;" 2>/dev/null

# Add Garmin Training Status columns
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_training_status TEXT;" 2>/dev/null
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_load_focus JSONB;" 2>/dev/null
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS garmin_recovery_hours DOUBLE PRECISION;" 2>/dev/null

# Add body composition columns
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS weight_kg DOUBLE PRECISION;" 2>/dev/null
psql -h 127.0.0.1 -U postgres -d pacer -c \
  "ALTER TABLE daily_metric ADD COLUMN IF NOT EXISTS body_fat_pct DOUBLE PRECISION;" 2>/dev/null

# Fix readiness_score table: align columns with Drizzle schema (v0.14.0 bug)
# Drizzle uses: score, zone, explanation
# Old metrics-compute.py used: readiness_score, readiness_zone, readiness_explanation
psql -h 127.0.0.1 -U postgres -d pacer -c "
DO \$\$
BEGIN
    -- Rename readiness_score → score if old column exists
    IF EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'public' AND table_name = 'readiness_score' AND column_name = 'readiness_score'
    ) THEN
        ALTER TABLE readiness_score RENAME COLUMN readiness_score TO score;
    END IF;
    -- Rename readiness_zone → zone if old column exists
    IF EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'public' AND table_name = 'readiness_score' AND column_name = 'readiness_zone'
    ) THEN
        ALTER TABLE readiness_score RENAME COLUMN readiness_zone TO zone;
    END IF;
    -- Rename readiness_explanation → explanation if old column exists
    IF EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'public' AND table_name = 'readiness_score' AND column_name = 'readiness_explanation'
    ) THEN
        ALTER TABLE readiness_score RENAME COLUMN readiness_explanation TO explanation;
    END IF;
END \$\$;
" 2>/dev/null || true

# Ensure ai_insight unique constraint exists (needed for upsert in generateInsights)
# First deduplicate if duplicates exist (keep newest row per user/date/type)
psql -h 127.0.0.1 -U postgres -d pacer -c "
DELETE FROM ai_insight a USING ai_insight b
WHERE a.id < b.id AND a.user_id = b.user_id AND a.date = b.date AND a.insight_type = b.insight_type;
" 2>/dev/null || true
psql -h 127.0.0.1 -U postgres -d pacer -c "
CREATE UNIQUE INDEX IF NOT EXISTS ai_insight_user_date_type_unique
    ON ai_insight (user_id, date, insight_type);
" 2>/dev/null || true

bashio::log.info "Creating daily_athlete_summary materialized view..."
psql -h 127.0.0.1 -U postgres -d pacer -f /app/sql/create_daily_athlete_summary.sql 2>&1 || bashio::log.warning "Matview creation had warnings (tables may not exist yet)"

# ─── Start Garmin sync in background ──────────────────────────────────────────
TOKEN_DIR="/data/garmin-tokens"
if [ -n "${GARMIN_EMAIL}" ] && [ -n "${GARMIN_PASSWORD}" ]; then
    bashio::log.info "Starting Garmin sync (every ${SYNC_INTERVAL} minutes)..."
    (
        while true; do
            bashio::log.info "Syncing Garmin data..."
            python3 /app/scripts/garmin-sync.py 2>&1 || bashio::log.warning "Garmin sync failed"
            backup_to_share
            sleep "$((SYNC_INTERVAL * 60))"
        done
    ) &
    SYNC_PID=$!
elif [ -f "${TOKEN_DIR}/oauth1_token.json" ] && [ -f "${TOKEN_DIR}/oauth2_token.json" ]; then
    bashio::log.info "Found saved Garmin tokens in ${TOKEN_DIR}"
    bashio::log.info "Starting Garmin sync from saved tokens (every ${SYNC_INTERVAL} minutes)..."
    (
        while true; do
            bashio::log.info "Syncing Garmin data..."
            python3 /app/scripts/garmin-sync.py 2>&1 || bashio::log.warning "Garmin sync failed"
            backup_to_share
            sleep "$((SYNC_INTERVAL * 60))"
        done
    ) &
    SYNC_PID=$!
else
    bashio::log.warning "No Garmin credentials or saved tokens — skipping auto-sync"
    bashio::log.info "Use Settings page to log in, or run scripts/generate-garmin-tokens.py locally"
fi

# ─── Start Strava sync in background (if configured) ─────────────────────────
if [ -n "${STRAVA_CLIENT_ID}" ] && [ -n "${STRAVA_CLIENT_SECRET}" ] && [ -n "${STRAVA_REFRESH_TOKEN}" ]; then
    bashio::log.info "Starting Strava sync (every ${SYNC_INTERVAL} minutes)..."
    (
        sleep 30
        while true; do
            bashio::log.info "Syncing Strava activities..."
            python3 /app/scripts/strava-sync.py 2>&1 || bashio::log.warning "Strava sync failed"
            backup_to_share
            sleep "$((SYNC_INTERVAL * 60))"
        done
    ) &
    STRAVA_SYNC_PID=$!
else
    bashio::log.info "No Strava credentials configured — skipping Strava sync"
fi

# ─── Start metrics compute in background ─────────────────────────────────────
bashio::log.info "Starting advanced metrics compute service..."
export COMPUTE_INTERVAL_MINUTES="${SYNC_INTERVAL}"
(
    # Wait for initial sync to complete before first compute (120s grace period)
    sleep 120
    while true; do
        # Cooperate with chained-from-sync runs and manual /auth/recompute
        # so we don't double-run metrics-compute. _clear_recompute_status
        # only updates the marker if it exists, so we always write
        # running:true here too.
        status_file="/data/garmin-tokens/.recompute_status"
        skip=0
        if [ -f "$status_file" ]; then
            if grep -q '"running":[[:space:]]*true' "$status_file" 2>/dev/null; then
                bashio::log.info "metrics-compute already running — skipping periodic pass"
                skip=1
            fi
        fi
        if [ "$skip" -eq 0 ]; then
            mkdir -p /data/garmin-tokens
            printf '{"running":true,"started":%s,"source":"s6-periodic"}' "$(date +%s)" > "$status_file"
            bashio::log.info "Computing advanced metrics..."
            python3 /app/scripts/metrics-compute.py --once 2>&1 || bashio::log.warning "Metrics compute failed"
        fi
        sleep "$((COMPUTE_INTERVAL_MINUTES * 60))"
    done
) &
COMPUTE_PID=$!

# ─── Start HA notification service ───────────────────────────────────────────
if [ -n "${SUPERVISOR_TOKEN}" ]; then
    bashio::log.info "Starting HA notification service..."
    export NOTIFY_INTERVAL_MINUTES="${SYNC_INTERVAL}"
    (
        sleep 180  # Wait for initial sync + metrics compute (3 min)
        while true; do
            bashio::log.info "Pushing Pacer sensors to HA..."
            python3 /app/scripts/ha-notify.py --once 2>&1 || bashio::log.warning "HA notify failed"
            sleep "$((NOTIFY_INTERVAL_MINUTES * 60))"
        done
    ) &
    NOTIFY_PID=$!
else
    bashio::log.info "No Supervisor token — skipping HA sensor push (add-on needs homeassistant_api: true)"
fi

# ─── Start coach memory rebuild in background (nightly) ──────────────────────
# Embeds multi-year history summaries (spec 007) so the coach can answer
# aggregate questions ("analyse all my runs this year"). Best-effort and
# idempotent; the endpoint self-skips when memory is disabled. Requires
# Ollama for embeddings, so only start the worker when an Ollama URL is set.
MEMORY_REBUILD_INTERVAL_MINUTES="${MEMORY_REBUILD_INTERVAL_MINUTES:-1440}"
if [ -n "${OLLAMA_URL}" ]; then
    bashio::log.info "Starting coach memory rebuild (every ${MEMORY_REBUILD_INTERVAL_MINUTES} minutes)..."
    (
        sleep 300  # let Next.js start and the first sync/compute settle
        while true; do
            bashio::log.info "Rebuilding coach memory embeddings..."
            curl -sf -m 600 -X POST \
                -H "x-internal-token: ${INTERNAL_TASK_TOKEN}" \
                http://127.0.0.1:3001/api/internal/rebuild-memory \
                2>&1 || bashio::log.warning "Coach memory rebuild failed"
            sleep "$((MEMORY_REBUILD_INTERVAL_MINUTES * 60))"
        done
    ) &
    MEMORY_PID=$!
else
    bashio::log.info "No Ollama URL — skipping coach memory rebuild (embeddings need Ollama)"
fi

# ─── Start Stress Board auto-rescore in background ──────────────────────────
# The Stress Board only scores on demand (manual ▶ run / POST /auth/meeting-stress).
# Meetings and logged interactions from the last hours usually have no Garmin
# heart rate yet (HR uploads lag), so they sit unscored until the user re-runs
# by hand. Periodically re-trigger the run so they appear on their own once HR
# syncs. The endpoint self-skips (HTTP 400 without a calendar/tokens) and
# de-dupes via its own running-guard (HTTP 409), so this is safe beside manual
# runs. Set the meeting_rescore_interval_minutes option to 0 to disable.
MEETING_RESCORE_INTERVAL_MINUTES="$(bashio::config 'meeting_rescore_interval_minutes' || echo "${MEETING_RESCORE_INTERVAL_MINUTES:-360}")"
# Sanitize: a non-integer would kill the loop in the $((...)) below and the
# monitor would restart it forever. Fall back to the default if it isn't a
# plain non-negative integer.
case "${MEETING_RESCORE_INTERVAL_MINUTES}" in
    ''|*[!0-9]*) MEETING_RESCORE_INTERVAL_MINUTES=360 ;;
esac
meeting_rescore_loop() {
    sleep 600  # let the auth server and first Garmin sync settle
    while true; do
        bashio::log.info "Auto-rescoring Stress Board..."
        code="$(curl -s -o /dev/null -w '%{http_code}' -m 900 -X POST \
            http://127.0.0.1:8099/auth/meeting-stress 2>/dev/null || echo "000")"
        case "${code}" in
            2*) : ;;  # run started
            400|409) bashio::log.info "Stress Board auto-rescore skipped (no calendar/tokens or already running)" ;;
            *) bashio::log.warning "Stress Board auto-rescore request failed (HTTP ${code})" ;;
        esac
        sleep "$((MEETING_RESCORE_INTERVAL_MINUTES * 60))"
    done
}
if [ "${MEETING_RESCORE_INTERVAL_MINUTES}" -gt 0 ] 2>/dev/null; then
    bashio::log.info "Starting Stress Board auto-rescore (every ${MEETING_RESCORE_INTERVAL_MINUTES} minutes)..."
    meeting_rescore_loop &
    RESCORE_PID=$!
else
    bashio::log.info "Stress Board auto-rescore disabled (interval <= 0)"
fi

# ─── Configure AI backend ─────────────────────────────────────────────────────
case "${AI_BACKEND}" in
    ha_conversation)
        if [ -n "${SUPERVISOR_TOKEN}" ]; then
            bashio::log.info "AI backend: HA Conversation API"
            bashio::log.info "  Requires a conversation agent configured in HA (Settings → Voice Assistants)"
            bashio::log.info "  Using Supervisor token for HA API access"
            if [ -n "${OLLAMA_URL}" ]; then
                if curl -s -o /dev/null -w "%{http_code}" "${OLLAMA_URL}/api/tags" | grep -q "200"; then
                    bashio::log.info "  Secondary backend: Ollama at ${OLLAMA_URL} (embeddings + fallback)"
                else
                    bashio::log.warning "  Secondary backend Ollama not reachable at ${OLLAMA_URL} — embeddings/fallback unavailable"
                fi
            fi
        else
            bashio::log.warning "AI backend set to ha_conversation but no Supervisor token — falling back to rules-based"
            export AI_BACKEND="none"
        fi
        ;;
    openrouter)
        if [ -n "${OPENROUTER_API_KEY}" ]; then
            bashio::log.info "AI backend: OpenRouter (model: ${OPENROUTER_MODEL})"
            bashio::log.info "  Direct OpenRouter API — no HA conversation agent required"
            bashio::log.info "  Routing: zero-data-retention endpoints only"
            bashio::log.info "  Reasoning: ${OPENROUTER_REASONING:-off}"
            if [ -n "${OPENROUTER_PROVIDERS}" ]; then
                bashio::log.info "  Routing: restricted to ${OPENROUTER_PROVIDERS} — no failover if unavailable"
            fi
        else
            bashio::log.warning "AI backend set to openrouter but no API key configured — falling back to rules-based"
            export AI_BACKEND="none"
            export OPENROUTER_API_KEY=""
        fi
        ;;
    ollama)
        if [ -n "${OLLAMA_URL}" ]; then
            if curl -s -o /dev/null -w "%{http_code}" "${OLLAMA_URL}/api/tags" | grep -q "200"; then
                bashio::log.info "AI backend: Ollama at ${OLLAMA_URL}"
            else
                bashio::log.warning "Ollama not reachable at ${OLLAMA_URL} — falling back to rules-based"
                export AI_BACKEND="none"
            fi
        else
            bashio::log.warning "AI backend set to ollama but no URL configured — falling back to rules-based"
            export AI_BACKEND="none"
        fi
        ;;
    none|*)
        bashio::log.info "AI backend: rules-based (no LLM)"
        export AI_BACKEND="none"
        ;;
esac

# ─── Start Next.js ────────────────────────────────────────────────────────────
bashio::log.info "Starting Pacer..."
cd /app/apps/nextjs

# Start Next.js on internal port (not exposed to ingress)
export HOSTNAME="127.0.0.1"
export PORT="3001"
node server.js &
NEXTJS_PID=$!

# Wait for Next.js to be ready
bashio::log.info "Waiting for Next.js..."
for i in $(seq 1 30); do
    if curl -s -o /dev/null http://127.0.0.1:3001/; then
        break
    fi
    sleep 1
done

# Start ingress proxy on port 3000 (HA ingress connects here)
# Rewrites HTML asset paths to work behind /api/hassio_ingress/<token>/
bashio::log.info "Starting ingress proxy..."
export PORT="3000"
export NEXT_INTERNAL_PORT="3001"
node /app/ingress-proxy.js &
INGRESS_PID=$!

# ─── Process monitoring loop ─────────────────────────────────────────────────
bashio::log.info "All services started — entering monitoring loop"
while true; do
    if [ "$SHUTTING_DOWN" = true ]; then
        break
    fi

    if [ -n "$SYNC_PID" ] && ! kill -0 "$SYNC_PID" 2>/dev/null; then
        bashio::log.warning "Garmin sync died, restarting..."
        (
            while true; do
                bashio::log.info "Syncing Garmin data..."
                python3 /app/scripts/garmin-sync.py 2>&1 || bashio::log.warning "Garmin sync failed"
                sleep "$((SYNC_INTERVAL * 60))"
            done
        ) &
        SYNC_PID=$!
    fi

    if [ -n "$COMPUTE_PID" ] && ! kill -0 "$COMPUTE_PID" 2>/dev/null; then
        bashio::log.warning "Metrics compute died, restarting..."
        (
            while true; do
                status_file="/data/garmin-tokens/.recompute_status"
                skip=0
                if [ -f "$status_file" ]; then
                    if grep -q '"running":[[:space:]]*true' "$status_file" 2>/dev/null; then
                        bashio::log.info "metrics-compute already running — skipping periodic pass"
                        skip=1
                    fi
                fi
                if [ "$skip" -eq 0 ]; then
                    mkdir -p /data/garmin-tokens
                    printf '{"running":true,"started":%s,"source":"s6-periodic"}' "$(date +%s)" > "$status_file"
                    bashio::log.info "Computing advanced metrics..."
                    python3 /app/scripts/metrics-compute.py --once 2>&1 || bashio::log.warning "Metrics compute failed"
                fi
                sleep "$((COMPUTE_INTERVAL_MINUTES * 60))"
            done
        ) &
        COMPUTE_PID=$!
    fi

    if [ -n "$NOTIFY_PID" ] && ! kill -0 "$NOTIFY_PID" 2>/dev/null; then
        bashio::log.warning "HA notify died, restarting..."
        (
            while true; do
                bashio::log.info "Pushing Pacer sensors to HA..."
                python3 /app/scripts/ha-notify.py --once 2>&1 || bashio::log.warning "HA notify failed"
                sleep "$((NOTIFY_INTERVAL_MINUTES * 60))"
            done
        ) &
        NOTIFY_PID=$!
    fi

    if [ -n "$MEMORY_PID" ] && ! kill -0 "$MEMORY_PID" 2>/dev/null; then
        bashio::log.warning "Coach memory rebuild died, restarting..."
        (
            sleep 300
            while true; do
                bashio::log.info "Rebuilding coach memory embeddings..."
                curl -sf -m 600 -X POST \
                    -H "x-internal-token: ${INTERNAL_TASK_TOKEN}" \
                    http://127.0.0.1:3001/api/internal/rebuild-memory \
                    2>&1 || bashio::log.warning "Coach memory rebuild failed"
                sleep "$((MEMORY_REBUILD_INTERVAL_MINUTES * 60))"
            done
        ) &
        MEMORY_PID=$!
    fi

    if [ -n "$RESCORE_PID" ] && ! kill -0 "$RESCORE_PID" 2>/dev/null; then
        bashio::log.warning "Stress Board auto-rescore died, restarting..."
        meeting_rescore_loop &
        RESCORE_PID=$!
    fi

    if ! kill -0 "$NEXTJS_PID" 2>/dev/null; then
        bashio::log.warning "Next.js died, restarting..."
        cd /app/apps/nextjs
        HOSTNAME="127.0.0.1" PORT="3001" node server.js &
        NEXTJS_PID=$!
    fi

    if ! kill -0 "$INGRESS_PID" 2>/dev/null; then
        bashio::log.warning "Ingress proxy died, restarting..."
        PORT="3000" NEXT_INTERNAL_PORT="3001" node /app/ingress-proxy.js &
        INGRESS_PID=$!
    fi

    sleep 60
done
